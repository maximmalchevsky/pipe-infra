#cloud-config
hostname: ${jsonencode(hostname)}
fqdn: ${jsonencode("${hostname}.${domain}")}
manage_etc_hosts: true
timezone: ${jsonencode(timezone)}
ssh_pwauth: false
disable_root: true
package_update: true
packages:
  - qemu-guest-agent
users:
  - name: ${jsonencode(user)}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys: ${jsonencode([ssh_key])}
runcmd:
  - systemctl enable --now qemu-guest-agent
