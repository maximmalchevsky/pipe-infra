apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: {{ argocd_namespace }}
spec:
  project: default
  source:
    repoURL: {{ argocd_root_app_repo_url }}
    targetRevision: {{ argocd_root_app_revision }}
    path: {{ argocd_root_app_path }}
    helm:
      valuesObject:
        repoURL: "{{ argocd_root_app_repo_url }}"
        targetRevision: "{{ argocd_root_app_revision }}"
        domain: "{{ cluster_domain }}"
        metallbIP: "{{ metallb_ip }}"
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
