# ==============================================================================
# Параметры подключения к Proxmox VE API
# ==============================================================================
# URL API Proxmox VE (например, https://192.168.1.10:8006/)
PROXMOX_VE_ENDPOINT=https://192.168.1.10:8006/

# API-токен Proxmox в формате USER@REALM!TOKENID=UUID
PROXMOX_VE_API_TOKEN=terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Пропуск проверки TLS-сертификата (true для самоподписанных сертификатов)
PROXMOX_VE_INSECURE=true

# ==============================================================================
# Размещение и хранилища Proxmox
# ==============================================================================
# Имя целевой ноды Proxmox VE для развертывания виртуальных машин
TF_VAR_proxmox_node=pve

# Хранилище Proxmox для дисков ВМ и cloud-init дисков (например, local-lvm)
TF_VAR_vm_datastore=local-lvm

# Хранилище Proxmox для ISO-образов и cloud-init сниппетов (должно поддерживать 'snippets' и 'iso')
TF_VAR_files_datastore=local

# ==============================================================================
# Сетевая конфигурация
# ==============================================================================
# Подсеть для виртуальных машин кластера в формате CIDR
TF_VAR_network_cidr=192.168.1.0/24

# IP-адрес шлюза по умолчанию
TF_VAR_gateway=192.168.1.1

# Список DNS-серверов для виртуальных машин кластера (в формате JSON/HCL массива)
TF_VAR_dns_servers=["192.168.1.1"]

# Поисковый DNS-домен
TF_VAR_search_domain=hackathon.lan

# Имя сетевого моста Linux Bridge в Proxmox
TF_VAR_network_bridge=vmbr0

# ==============================================================================
# Размер кластера Kubernetes
# ==============================================================================
# Количество master/control-plane нод. Должно быть нечётным (1, 3, 5) для кворума etcd
TF_VAR_control_count=1

# Количество worker нод (>= 0)
TF_VAR_worker_count=2

# ==============================================================================
# IP-адресация и VM ID
# ==============================================================================
# Схема распределения IP в подсети network_cidr:
#   - Control-plane ноды: начинаются с control_ip_start (.161 -> .161-.169)
#   - Keepalived VIP: фиксирован на .170 (используется при control_count > 1)
#   - Worker ноды: начинаются с worker_ip_start (.171 -> .171-.174)
#   - MetalLB пул: .175 (выделен под LoadBalancer сервисы)
#
# Начальный октет IP для control-plane нод
TF_VAR_control_ip_start=161

# Начальный октет IP для worker нод
TF_VAR_worker_ip_start=171

# Номер хоста в network_cidr для MetalLB LoadBalancer IP (ingress-nginx)
TF_VAR_metallb_ip_hostnum=175

# Начальный VM ID в Proxmox для control-plane нод
TF_VAR_control_vm_id_start=9101

# Начальный VM ID в Proxmox для worker нод
TF_VAR_worker_vm_id_start=9121

# ==============================================================================
# Выделение ресурсов (CPU, RAM, диск)
# ==============================================================================
# Ресурсы для control-plane нод (cores, memory_mb, disk_gb)
TF_VAR_control_resources={ cores = 2, memory_mb = 4096, disk_gb = 30 }

# Ресурсы для worker нод (cores, memory_mb, disk_gb)
TF_VAR_worker_resources={ cores = 2, memory_mb = 4096, disk_gb = 30 }
